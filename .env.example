# Copia este archivo como .env y rellena los valores.
# Las variables EXPO_PUBLIC_* se incrustan en el bundle de la app al compilar.

# ID de la aplicación de Discord (Developer Portal → tu app → General Information → Application ID).
# Sin él, la opción "Mostrar lo que escuchas" aparece como no disponible.
EXPO_PUBLIC_DISCORD_APP_ID=

# Jamendo (developer.jamendo.com → tu app). El client_id basta para buscar y descargar.
EXPO_PUBLIC_JAMENDO_CLIENT_ID=
# Opcional, solo para OAuth. Nunca le pongas el prefijo EXPO_PUBLIC_: se incrustaría en el APK.
JAMENDO_CLIENT_SECRET=

# Salas (Supabase Realtime: supabase.com → tu proyecto → Project Settings → API).
# La anon key es pública por diseño; las salas no usan tablas, solo canales en tiempo real.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Página de invitación del botón "Unirse a escuchar juntos" en Discord (docs/jam/ publicada con GitHub Pages).
# Vacío: https://yizuscz.github.io/QuartzPlayer/jam/
EXPO_PUBLIC_JAM_LINK=
