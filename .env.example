# Copia este archivo como .env y rellena los valores.
# Las variables EXPO_PUBLIC_* se incrustan en el bundle de la app al compilar.

# ID de la aplicación de Discord (Developer Portal → tu app → General Information → Application ID).
# Sin él, la opción "Mostrar lo que escuchas" aparece como no disponible.
EXPO_PUBLIC_DISCORD_APP_ID=
