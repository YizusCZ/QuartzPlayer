<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- Only Rich Presence is used: drop the SDK's voice-call foreground service. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />
  <application>
    <service android:name="com.discord.socialsdk.ForegroundService" tools:node="remove" />
  </application>
</manifest>
