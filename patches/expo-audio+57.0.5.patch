+      reverb = Reverb(sr)
+      echo = Echo(sr)
+      bassL.lowShelf(sr, 110.0, 9.0)
+      bassR.lowShelf(sr, 110.0, 9.0)
+      karaokeLow.lowpass(sr, 160.0)
+      filterMode = -1
+    }
+    channels = fmt.channelCount
+    float = fmt.encoding == C.ENCODING_PCM_FLOAT
+    reverb?.clear()
+    echo?.clear()
+    listOf(bassL, bassR, lpL, lpR, hpL, hpR, karaokeLow).forEach { it.clear() }
+  }
