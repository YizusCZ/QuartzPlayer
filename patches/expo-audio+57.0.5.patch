+/**
+ * Quartz patch: combinable sound effects (reverb, echo, 8D, bass boost, lo-fi /
+ * radio filters, karaoke) running inside ExoPlayer's audio pipeline, before
+ * speed/pitch. Settings are pushed from the AudioDsp module through
+ * [QuartzFx.configure] and read on every buffer; each effect fades in and out
+ * so toggling never clicks.
+ */
+@UnstableApi
+object QuartzFx {
+  /** 0–1 wet amounts / flags, written from the JS thread. */
+  @Volatile var reverb = 0f
+  @Volatile var roomSize = 0.82f
+  @Volatile var echo = 0f
+  @Volatile var eightD = 0f
+  @Volatile var bass = 0f
+  /** 0 none, 1 lo-fi, 2 radio. */
+  @Volatile var filter = 0
+  @Volatile var karaoke = 0f
+
+  /** [reverb, roomSize, echo, eightD, bass, filter, karaoke] */
+  @JvmStatic
+  fun configure(values: FloatArray) {
+    reverb = values.getOrElse(0) { 0f }.coerceIn(0f, 1f)
+    roomSize = values.getOrElse(1) { 0.82f }.coerceIn(0.5f, 0.97f)
+    echo = values.getOrElse(2) { 0f }.coerceIn(0f, 1f)
+    eightD = values.getOrElse(3) { 0f }.coerceIn(0f, 1f)
+    bass = values.getOrElse(4) { 0f }.coerceIn(0f, 1f)
+    filter = values.getOrElse(5) { 0f }.toInt()
+    karaoke = values.getOrElse(6) { 0f }.coerceIn(0f, 1f)
+  }
+
+  fun renderersFactory(context: Context) = object : DefaultRenderersFactory(context) {
+    override fun buildAudioSink(
+      context: Context,
+      enableFloatOutput: Boolean,
+      enableAudioTrackPlaybackParams: Boolean,
+    ): AudioSink =
+      DefaultAudioSink.Builder(context)
+        .setEnableFloatOutput(enableFloatOutput)
+        .setEnableAudioTrackPlaybackParams(enableAudioTrackPlaybackParams)
+        .setAudioProcessors(arrayOf<AudioProcessor>(QuartzFxProcessor()))
+        .build()
+  }
+}
+
+/** RBJ biquad, transposed direct form II. */
+private class Biquad {
+  private var b0 = 1f
+  private var b1 = 0f
+  private var b2 = 0f
+  private var a1 = 0f
+  private var a2 = 0f
+  private var z1 = 0f
+  private var z2 = 0f
+
+  fun lowpass(sr: Int, f: Double, q: Double = 0.707) = rbj(sr, f, q) { cw, alpha ->
+    doubleArrayOf((1 - cw) / 2, 1 - cw, (1 - cw) / 2, 1 + alpha, -2 * cw, 1 - alpha)
+  }
+
+  fun highpass(sr: Int, f: Double, q: Double = 0.707) = rbj(sr, f, q) { cw, alpha ->
+    doubleArrayOf((1 + cw) / 2, -(1 + cw), (1 + cw) / 2, 1 + alpha, -2 * cw, 1 - alpha)
+  }
+
+  fun lowShelf(sr: Int, f: Double, db: Double) {
+    val a = 10.0.pow(db / 40)
+    val w = 2 * PI * f / sr
+    val cw = cos(w)
+    val alpha = sin(w) / 2 * sqrt(2.0)
+    val sa = 2 * sqrt(a) * alpha
+    set(
+      doubleArrayOf(
+        a * ((a + 1) - (a - 1) * cw + sa),
+        2 * a * ((a - 1) - (a + 1) * cw),
+        a * ((a + 1) - (a - 1) * cw - sa),
+        (a + 1) + (a - 1) * cw + sa,
+        -2 * ((a - 1) + (a + 1) * cw),
+        (a + 1) + (a - 1) * cw - sa,
+      ),
+    )
+  }
+
+  private inline fun rbj(sr: Int, f: Double, q: Double, c: (Double, Double) -> DoubleArray) {
+    val w = 2 * PI * min(f, sr * 0.45) / sr
+    set(c(cos(w), sin(w) / (2 * q)))
+  }
+
+  private fun set(c: DoubleArray) {
+    b0 = (c[0] / c[3]).toFloat()
+    b1 = (c[1] / c[3]).toFloat()
+    b2 = (c[2] / c[3]).toFloat()
+    a1 = (c[4] / c[3]).toFloat()
+    a2 = (c[5] / c[3]).toFloat()
+  }
+
+  fun clear() {
+    z1 = 0f
+    z2 = 0f
+  }
+
+  fun run(x: Float): Float {
+    val y = b0 * x + z1
+    z1 = b1 * x - a1 * y + z2
+    z2 = b2 * x - a2 * y
+    return y
+  }
+}
+
+/** Freeverb comb with one-pole damping. */
+private class Comb(size: Int) {
+  private val buf = FloatArray(size)
+  private var i = 0
+  private var store = 0f
+
+  fun clear() {
+    buf.fill(0f)
+    store = 0f
+  }
+
+  fun run(x: Float, feedback: Float, damp: Float): Float {
+    val y = buf[i]
+    store = y * (1 - damp) + store * damp
+    buf[i] = x + store * feedback
+    if (++i >= buf.size) i = 0
+    return y
+  }
+}
+
+private class Allpass(size: Int) {
+  private val buf = FloatArray(size)
+  private var i = 0
+
+  fun clear() = buf.fill(0f)
+
+  fun run(x: Float): Float {
+    val b = buf[i]
+    buf[i] = x + b * 0.5f
+    if (++i >= buf.size) i = 0
+    return b - x
+  }
+}
+
+/** Stereo Freeverb (Jezar's tunings, scaled to the sample rate). */
+private class Reverb(sr: Int) {
+  private val scale = sr / 44100.0
+  private fun n(len: Int) = max(1, (len * scale).toInt())
+  private val combL = intArrayOf(1116, 1188, 1277, 1356, 1422, 1491, 1557, 1617).map { Comb(n(it)) }
+  private val combR = intArrayOf(1116, 1188, 1277, 1356, 1422, 1491, 1557, 1617).map { Comb(n(it + 23)) }
+  private val apL = intArrayOf(556, 441, 341, 225).map { Allpass(n(it)) }
+  private val apR = intArrayOf(556, 441, 341, 225).map { Allpass(n(it + 23)) }
+  private val pre = Biquad().apply { highpass(sr, 180.0) }
+
+  fun clear() {
+    combL.forEach { it.clear() }
+    combR.forEach { it.clear() }
+    apL.forEach { it.clear() }
+    apR.forEach { it.clear() }
+    pre.clear()
+  }
+
+  /** Writes the wet signal into out[0..1]. */
+  fun run(l: Float, r: Float, room: Float, out: FloatArray) {
+    val x = pre.run((l + r) * 0.015f)
+    var ol = 0f
+    var orr = 0f
+    for (c in combL) ol += c.run(x, room, 0.3f)
+    for (c in combR) orr += c.run(x, room, 0.3f)
+    for (a in apL) ol = a.run(ol)
+    for (a in apR) orr = a.run(orr)
+    out[0] = ol
+    out[1] = orr
+  }
+}
+
+/** Ping-pong echo, ~330 ms, with a darkening feedback path. */
+private class Echo(sr: Int) {
+  private val len = max(1, (sr * 0.33).toInt())
+  private val bufL = FloatArray(len)
+  private val bufR = FloatArray(len)
+  private var i = 0
+  private val toneL = Biquad().apply { lowpass(sr, 3500.0) }
+  private val toneR = Biquad().apply { lowpass(sr, 3500.0) }
+
+  fun clear() {
+    bufL.fill(0f)
+    bufR.fill(0f)
+    toneL.clear()
+    toneR.clear()
+  }
+
+  fun run(l: Float, r: Float, out: FloatArray) {
+    val dl = bufL[i]
+    val dr = bufR[i]
+    bufL[i] = toneL.run((l + r) * 0.5f + dr * 0.42f)
+    bufR[i] = toneR.run(dl * 0.42f)
+    if (++i >= len) i = 0
+    out[0] = dl
+    out[1] = dr
+  }
+}
