+    filterMode = mode
+    when (mode) {
+      1 -> { // lo-fi: dull top, thin bottom
+        lpL.lowpass(sr, 3200.0); lpR.lowpass(sr, 3200.0)
+        hpL.highpass(sr, 90.0); hpR.highpass(sr, 90.0)
+      }
+      2 -> { // radio / phone: narrow band
+        lpL.lowpass(sr, 3000.0, 1.0); lpR.lowpass(sr, 3000.0, 1.0)
+        hpL.highpass(sr, 450.0, 1.0); hpR.highpass(sr, 450.0, 1.0)
