+@UnstableApi
+private class QuartzFxProcessor : BaseAudioProcessor() {
+  private var sr = 44100
+  private var channels = 2
+  private var float = false
+
+  private var reverb: Reverb? = null
+  private var echo: Echo? = null
+  private val bassL = Biquad()
+  private val bassR = Biquad()
+  private val lpL = Biquad()
+  private val lpR = Biquad()
+  private val hpL = Biquad()
+  private val hpR = Biquad()
+  private val karaokeLow = Biquad()
+  private var filterMode = 0
+
+  // Smoothed wet amounts.
+  private var mReverb = 0f
+  private var mEcho = 0f
+  private var m8d = 0f
+  private var mBass = 0f
+  private var mFilter = 0f
+  private var mKaraoke = 0f
