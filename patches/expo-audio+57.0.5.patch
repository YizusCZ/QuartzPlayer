+package expo.modules.audio
+
+import android.content.Context
+import android.net.Uri
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.database.StandaloneDatabaseProvider
+import androidx.media3.datasource.DataSource
+import androidx.media3.datasource.DataSpec
+import androidx.media3.datasource.cache.CacheDataSource
+import androidx.media3.datasource.cache.CacheKeyFactory
+import androidx.media3.datasource.cache.CacheWriter
+import androidx.media3.datasource.cache.LeastRecentlyUsedCacheEvictor
+import androidx.media3.datasource.cache.SimpleCache
+import androidx.media3.exoplayer.DefaultLoadControl
+import androidx.media3.exoplayer.LoadControl
+import java.io.File
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+/**
+ * Quartz patch: playback buffering.
+ *
+ *  - A disk cache (LRU, 256 MB) under every streamed song: a song heard again,
+ *    a seek back, or rejoining a room reads from disk instead of the network.
+ *    YouTube stream URLs are signed and change each time, so the cache key is
+ *    the stream itself (video, format, length), not the URL.
+ *  - `precache` fetches the first seconds of the next song into that cache
+ *    near the end of the current one, so the next one starts instantly.
+ *  - A load control tuned for music: starts after half a second of audio and
+ *    reads in bursts between 20 and 60 s ahead, so the radio sleeps in between
+ *    and a skipped song wastes little. Seeks back come from the disk cache, so
+ *    only 5 s are kept in memory.
+ */
+@UnstableApi
+object QuartzCache {
+  private const val MAX_BYTES = 256L * 1024 * 1024
+  /** About 16 s of a 256 kbps stream: enough to start at once while the rest loads. */
+  private const val PRECACHE_BYTES = 512L * 1024
+
+  @Volatile
+  private var cache: SimpleCache? = null
+  private val worker =
+    Executors.newSingleThreadScheduledExecutor { r -> Thread(r, "QuartzPrecache").apply { isDaemon = true } }
+  /** Lets a burst of song changes settle, so only the last one is fetched. */
+  private const val PRECACHE_DELAY_S = 1L
+  private var precaching: CacheWriter? = null
+  private var precachingKey: String? = null
+
+  private fun cacheOf(context: Context): SimpleCache =
+    cache ?: synchronized(this) {
+      cache ?: SimpleCache(
+        File(context.cacheDir, "quartz-audio"),
+        LeastRecentlyUsedCacheEvictor(MAX_BYTES),
+        StandaloneDatabaseProvider(context)
+      ).also { cache = it }
+    }
+
+  /** googlevideo URLs: `id` (the stream), `itag` (the format), `clen` (its size) identify the bytes. */
+  val keyFactory = CacheKeyFactory { spec -> keyFor(spec.uri) ?: spec.key ?: spec.uri.toString() }
+
+  private fun keyFor(uri: Uri): String? {
+    if (uri.host?.endsWith("googlevideo.com") != true) return null
+    val id = uri.getQueryParameter("id") ?: return null
+    val itag = uri.getQueryParameter("itag") ?: return null
+    return "yt:$id:$itag:${uri.getQueryParameter("clen") ?: ""}"
+  }
+
+  fun factory(context: Context, upstream: DataSource.Factory): DataSource.Factory =
+    CacheDataSource.Factory()
+      .setCache(cacheOf(context))
+      .setUpstreamDataSourceFactory(upstream)
+      .setCacheKeyFactory(keyFactory)
+      .setFlags(CacheDataSource.FLAG_IGNORE_CACHE_ON_ERROR)
+
+  /** Warms the cache with the start of `url` (one at a time; a newer request replaces the last). */
+  fun precache(context: Context, url: String, upstream: DataSource.Factory) {
+    val uri = Uri.parse(url)
+    val key = keyFor(uri) ?: return
+    synchronized(this) {
+      if (precachingKey == key) return
+      precaching?.cancel()
+      precachingKey = key
+    }
+    val source = factory(context, upstream).createDataSource() as CacheDataSource
+    val spec = DataSpec.Builder().setUri(uri).setLength(PRECACHE_BYTES).setKey(key).build()
+    val writer = CacheWriter(source, spec, null, null)
+    synchronized(this) { precaching = writer }
+    worker.schedule({
+      try {
+        writer.cache()
+      } catch (_: Throwable) {
+        // cancelled, offline, or the URL expired: the song just loads normally
+      } finally {
+        synchronized(this) {
+          if (precaching === writer) {
+            precaching = null
+            precachingKey = null
+          }
+        }
+      }
+    }, PRECACHE_DELAY_S, TimeUnit.SECONDS)
+  }
+
+  fun loadControl(): LoadControl =
+    DefaultLoadControl.Builder()
+      .setBufferDurationsMs(
+        20_000,
+        60_000,
+        500,
+        1_500
+      )
+      .setTargetBufferBytes(8 * 1024 * 1024)
+      .setPrioritizeTimeOverSizeThresholds(true)
+      .setBackBuffer(5_000, true)
+      .build()
+}
