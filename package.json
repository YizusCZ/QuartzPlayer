    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "preview": "tsx --tsconfig tools/tsconfig.preview.json tools/preview.tsx",
    "lint": "expo lint",
    "brand": "python3 tools/brand_assets.py",
